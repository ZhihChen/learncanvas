'use client';

/**
 * 上下文预览组件
 * 悬停连线时显示传递的上下文内容
 */

import { memo, useMemo } from 'react';
import { 
  MessageSquare, 
  FileText, 
  Hash, 
  ChevronRight,
  Sparkles,
  Clock,
  ArrowRight,
} from 'lucide-react';
import { cn } from '@/lib/utils';
import type { 
  ContextTransferStrategy, 
  ContextPreview as ContextPreviewType,
  Message,
} from '@/types';

interface ContextPreviewProps {
  preview: ContextPreviewType;
  position: { x: number; y: number };
  visible: boolean;
}

// 策略标签配置
const strategyConfig: Record<ContextTransferStrategy, { label: string; icon: typeof MessageSquare; color: string }> = {
  all: { label: '全部消息', icon: MessageSquare, color: 'text-blue-400' },
  summary: { label: '智能摘要', icon: Sparkles, color: 'text-[#2383E2]' },
  recent: { label: '最近消息', icon: Clock, color: 'text-[#2383E2]' },
  custom: { label: '自定义', icon: Hash, color: 'text-teal-400' },
};

function ContextPreviewComponent({ preview, position, visible }: ContextPreviewProps) {
  const { 
    sourceNodeTitle, 
    strategy, 
    messageCount, 
    previewContent,
    summary,
  } = preview;
  
  const config = strategyConfig[strategy];
  const Icon = config.icon;
  
  // 截断预览内容
  const displayContent = useMemo(() => {
    const content = strategy === 'summary' && summary ? summary : previewContent;
    if (content.length > 150) {
      return content.slice(0, 150) + '...';
    }
    return content;
  }, [strategy, summary, previewContent]);
  
  if (!visible) return null;
  
  return (
    <div
      className={cn(
        'fixed z-[9999] pointer-events-none',
        'w-80 p-4 rounded-lg',
        'bg-[#F7F6F3]
        ' border border-bg-[#F7F6F3]',
        'shadow-lg shadow-bg-[#F7F6F3]',
        'transform -translate-x-1/2 -translate-y-full -mt-3',
        'animate-in fade-in-0 zoom-in-95 duration-200',
      )}
      style={{ left: position.x, top: position.y }}
    >
      {/* 发光效果 */}
      <div className="absolute inset-0 rounded-lg bg-[#F7F6F3] via-bg-[#F7F6F3] to-bg-[#F7F6F3] " />
      
      {/* 内容 */}
      <div className="relative">
        {/* 头部：来源节点 */}
        <div className="flex items-center gap-2 mb-3 pb-2 border-b border-bg-[#F7F6F3]">
          <div className="p-1.5 rounded-lg bg-bg-[#F7F6F3]">
            <MessageSquare className="w-3.5 h-3.5 text-[#2383E2]" />
          </div>
          <div className="flex-1 min-w-0">
            <div className="text-xs text-[#9B9A97] mb-0.5">上下文来源</div>
            <div className="text-sm font-medium text-[#37352F] truncate">{sourceNodeTitle}</div>
          </div>
        </div>
        
        {/* 传递策略 */}
        <div className="flex items-center gap-2 mb-3">
          <div className={cn('flex items-center gap-1.5 px-2 py-1 rounded-lg bg-white/5', config.color)}>
            <Icon className="w-3.5 h-3.5" />
            <span className="text-xs font-medium">{config.label}</span>
          </div>
          <div className="flex items-center gap-1 text-xs text-[#9B9A97]">
            <Hash className="w-3 h-3" />
            <span>{messageCount} 条消息</span>
          </div>
        </div>
        
        {/* 预览内容 */}
        <div className="p-3 rounded-lg bg-slate-900/50 border border-slate-700/30">
          <div className="text-xs text-[#9B9A97] mb-1.5 flex items-center gap-1">
            <FileText className="w-3 h-3" />
            内容预览
          </div>
          <p className="text-sm text-[#787774] leading-relaxed line-clamp-4">
            {displayContent || '暂无内容'}
          </p>
        </div>
        
        {/* 底部提示 */}
        <div className="flex items-center justify-center gap-1 mt-3 pt-2 border-t border-bg-[#F7F6F3]">
          <span className="text-xs text-[#9B9A97]">点击连线可编辑传递策略</span>
        </div>
      </div>
    </div>
  );
}

export const ContextPreview = memo(ContextPreviewComponent);

/**
 * 获取上下文预览数据
 */
export function getContextPreview(
  sourceNodeId: string,
  nodes: Array<{ id: string; data: { title?: string; messages?: Message[]; summary?: string } }>,
  strategy: ContextTransferStrategy = 'all',
  recentCount: number = 3,
): ContextPreviewType {
  const sourceNode = nodes.find(n => n.id === sourceNodeId);
  if (!sourceNode) {
    return {
      sourceNodeId,
      sourceNodeTitle: '未知节点',
      strategy,
      messageCount: 0,
      previewContent: '',
    };
  }
  
  const messages = sourceNode.data.messages || [];
  const summary = sourceNode.data.summary;
  
  // 根据策略生成预览内容
  let previewContent = '';
  let fullContent = '';
  
  switch (strategy) {
    case 'summary':
      previewContent = summary || generateQuickSummary(messages);
      fullContent = summary || '';
      break;
    case 'recent':
      const recentMessages = messages.slice(-recentCount);
      previewContent = recentMessages.map(m => 
        `${m.role === 'user' ? '👤' : '🤖'} ${m.content}`
      ).join('\n');
      fullContent = previewContent;
      break;
    case 'custom':
    case 'all':
    default:
      previewContent = messages.slice(0, 3).map(m => 
        `${m.role === 'user' ? '👤' : '🤖'} ${m.content}`
      ).join('\n');
      fullContent = messages.map(m => 
        `${m.role === 'user' ? '👤' : '🤖'} ${m.content}`
      ).join('\n');
  }
  
  return {
    sourceNodeId,
    sourceNodeTitle: sourceNode.data.title || '未命名节点',
    strategy,
    messageCount: messages.length,
    previewContent,
    fullContent,
    summary,
  };
}

/**
 * 快速生成简单摘要（不调用API）
 */
function generateQuickSummary(messages: Message[]): string {
  if (messages.length === 0) return '暂无对话内容';
  
  const userMessages = messages.filter(m => m.role === 'user');
  const assistantMessages = messages.filter(m => m.role === 'assistant');
  
  const topics = userMessages.slice(0, 2).map(m => {
    const content = m.content;
    // 提取关键词
    if (content.length > 30) {
      return content.slice(0, 30) + '...';
    }
    return content;
  });
  
  if (topics.length === 0) return '暂无对话内容';
  
  return `讨论了 ${topics.length} 个话题：${topics.join('、')}`;
}
