'use client';

/**
 * 聊天节点组件
 * 支持四个方向连接点，适用于树状结构
 */

import { memo, useState, useRef, useEffect, useCallback, useMemo, useTransition } from 'react';
import { Handle, Position, type NodeProps } from '@xyflow/react';
import { toPng } from 'html-to-image';
import '@/components/node/nodes.css';
import { 
  MessageSquare, 
  MoreVertical, 
  Trash2, 
  ChevronDown, 
  ChevronUp,
  Sparkles,
  Edit3,
  Settings,
  X,
  Plus,
  Link2,
  Check,
  Maximize2,
  Image as ImageIcon,
  Paperclip,
  Download,
} from 'lucide-react';
import { useCanvasStore } from '@/store/canvasStore';
import type { Message, Attachment } from '@/types';
import { getUpstreamNodes, aggregateContext } from '@/lib/contextUtils';
import { cn } from '@/lib/utils';
import { MarkdownRenderer } from '@/components/chat/MarkdownRenderer';
import { NodeReferencePicker } from './NodeReferencePicker';
import { AIAssistant } from '@/components/assistant/AIAssistant';
import { useTextSelection, type TextSelection } from '@/hooks/useTextSelection';
import { HighlightMenu } from '@/components/excerpt/HighlightMenu';
import { TargetNodePicker } from '@/components/excerpt/TargetNodePicker';
import { NoteInputDialog } from '@/components/excerpt/NoteInputDialog';
import { QuoteBlock, type QuoteData } from '@/components/chat/QuoteBlock';
import { PlanDetector } from '@/components/plan/PlanDetector';

// 系统提示词输入组件 - 使用本地 state 避免 IME 输入问题
const SystemPromptInput = ({ 
  nodeId, 
  systemPrompt, 
  updateNodeData,
  onClose 
}: { 
  nodeId: string;
  systemPrompt?: string;
  updateNodeData: (id: string, data: { systemPrompt?: string }) => void;
  onClose: () => void;
}) => {
  const [localValue, setLocalValue] = useState(systemPrompt || '');
  const textareaRef = useRef<HTMLTextAreaElement>(null);
  
  // 同步外部值变化
  useEffect(() => {
    setLocalValue(systemPrompt || '');
  }, [systemPrompt]);
  
  // 失焦时保存到 store
  const handleBlur = useCallback(() => {
    updateNodeData(nodeId, { systemPrompt: localValue });
  }, [nodeId, localValue, updateNodeData]);
  
  // 阻止所有事件冒泡到 React Flow
  const stopPropagation = useCallback((e: React.SyntheticEvent) => {
    e.stopPropagation();
  }, []);
  
  return (
    <div 
      className="px-4 py-3 border-b border-bg-[#F7F6F3] bg-amber-500/5"
      onMouseDown={stopPropagation}
      onMouseUp={stopPropagation}
      onClick={stopPropagation}
      onPointerDown={stopPropagation}
      onDoubleClick={stopPropagation}
      onKeyDown={stopPropagation}
      onKeyUp={stopPropagation}
      onKeyPress={stopPropagation}
    >
      <div className="flex items-center justify-between mb-2">
        <span className="text-xs text-[#787774]">系统提示词</span>
        <button
          onClick={(e) => {
            e.stopPropagation();
            onClose();
          }}
          className="text-[#9B9A97] hover:text-[#787774]"
        >
          <X className="w-4 h-4" />
        </button>
      </div>
      <textarea
        ref={textareaRef}
        value={localValue}
        onChange={(e) => {
          e.stopPropagation();
          setLocalValue(e.target.value);
        }}
        onBlur={handleBlur}
        placeholder="设置该节点的系统提示词..."
        rows={3}
        className="w-full px-3 py-2 text-xs bg-white/5 border border-bg-[#F7F6F3] rounded-lg text-[#37352F] placeholder-[#C4C4C4] resize-none focus:outline-none focus:border-amber-500/50"
      />
    </div>
  );
};

// 单独的消息项组件 - 使用 memo 避免不必要的重新渲染
const MessageItem = memo(({ message }: { message: Message }) => {
  const { allExcerpts } = useCanvasStore();
  
  // 应用高亮标记到内容
  const highlightedContent = useMemo(() => {
    if (!message.highlights || message.highlights.length === 0) {
      return message.content;
    }
    
    let content = message.content;
    
    // 按起始位置倒序排列，从后往前替换，避免 offset 变化
    const sortedHighlights = [...message.highlights].sort((a, b) => b.startOffset - a.startOffset);
    
    for (const highlight of sortedHighlights) {
      // 找到对应的摘录内容
      const excerpt = highlight.excerptId ? allExcerpts.find(e => e.id === highlight.excerptId) : null;
      const highlightText = excerpt?.content;
      
      if (!highlightText) continue;
      
      // 在内容中搜索匹配的文本
      const index = content.indexOf(highlightText);
      if (index !== -1) {
        // 用 ==text== 包裹
        content = content.slice(0, index) + `==${highlightText}==` + content.slice(index + highlightText.length);
      }
    }
    
    return content;
  }, [message.content, message.highlights, allExcerpts]);
  
  return (
    <div
      data-message-id={message.id}
      data-message-content
      className={cn(
        'flex',
        message.role === 'user' ? 'justify-end' : 'justify-start'
      )}
    >
      <div
        className={cn(
          'max-w-[90%] px-3 py-2 rounded-sm',
        )}
        style={{
          backgroundColor: message.role === 'user' ? 'var(--accent-primary)' : 'var(--bg-secondary)',
          color: message.role === 'user' ? '#FFFFFF' : 'var(--text-primary)'
        }}
      >
        {message.status === 'streaming' && !message.content ? (
          <span className="inline-flex items-center gap-1.5 text-sm">
            <span className="w-1 h-1 rounded-full animate-pulse" style={{ backgroundColor: 'var(--accent-primary)' }} />
            <span className="w-1 h-1 rounded-full animate-pulse" style={{ backgroundColor: 'var(--accent-primary)', animationDelay: '0.1s' }} />
            <span className="w-1 h-1 rounded-full animate-pulse" style={{ backgroundColor: 'var(--accent-primary)', animationDelay: '0.2s' }} />
          </span>
        ) : message.role === 'assistant' ? (
          <MarkdownRenderer content={highlightedContent} />
        ) : (
          <span className="text-sm whitespace-pre-wrap">{highlightedContent}</span>
        )}
      </div>
    </div>
  );
}, (prevProps, nextProps) => {
  // 自定义比较：只有当消息的关键属性变化时才重新渲染
  return (
    prevProps.message.id === nextProps.message.id &&
    prevProps.message.content === nextProps.message.content &&
    prevProps.message.role === nextProps.message.role &&
    prevProps.message.status === nextProps.message.status
  );
});
MessageItem.displayName = 'MessageItem';

// 节点默认尺寸
const NODE_WIDTH = 380;
const NODE_MIN_HEIGHT = 200;

// 节点状态类型
type NodeStatus = 'idle' | 'active' | 'completed';

// 状态颜色映射
const statusColors: Record<NodeStatus, string> = {
  idle: 'bg-stone-500',
  active: 'bg-amber-500',
  completed: 'bg-emerald-500',
};

// 自定义节点 Props 类型
type ChatNodeProps = NodeProps & {
  data: {
    title: string;
    messages: Message[];
    collapsed?: boolean;
    isStreaming?: boolean;
    tags?: string[];
    contextFrom?: string[];
    systemPrompt?: string;
    status?: NodeStatus;
    summary?: string;
    contextEnabled?: { [nodeId: string]: boolean };
  };
};

function ChatNodeComponent({ id, data, selected }: ChatNodeProps) {
  const { 
    title, 
    messages = [], 
    collapsed, 
    isStreaming, 
    tags = [],
    systemPrompt,
    status = 'idle',
    summary,
    contextEnabled = {},
  } = data;
  
  // 状态
  const [inputValue, setInputValue] = useState('');
  const [isMenuOpen, setIsMenuOpen] = useState(false);
  const [isEditingTitle, setIsEditingTitle] = useState(false);
  const [editTitleValue, setEditTitleValue] = useState(title);
  const [isAddingTag, setIsAddingTag] = useState(false);
  const [newTagValue, setNewTagValue] = useState('');
  const [showContextPanel, setShowContextPanel] = useState(false);
  const [showSettings, setShowSettings] = useState(false);
  const [isSummaryCollapsed, setIsSummaryCollapsed] = useState(true); // 默认折叠，不占用空间
  
  // @ 引用相关状态
  const [showReferencePicker, setShowReferencePicker] = useState(false);
  const [referencePickerPosition, setReferencePickerPosition] = useState({ x: 0, y: 0 });
  const [referenceStartPos, setReferenceStartPos] = useState(0);
  
  // 摘录相关状态
  const [showTargetPicker, setShowTargetPicker] = useState(false);
  const [pendingExcerptType, setPendingExcerptType] = useState<'excerpt' | 'note'>('excerpt');
  const [showNoteInputDialog, setShowNoteInputDialog] = useState(false);
  const [pendingNote, setPendingNote] = useState('');
  
  // 引用块状态（用于提问功能）
  const [activeQuote, setActiveQuote] = useState<QuoteData | null>(null);
  const [inputFocused, setInputFocused] = useState(false);
  
  // Refs
  const inputRef = useRef<HTMLTextAreaElement>(null);
  const messagesEndRef = useRef<HTMLDivElement>(null);
  const titleInputRef = useRef<HTMLInputElement>(null);
  const tagInputRef = useRef<HTMLInputElement>(null);
  const nodeRef = useRef<HTMLDivElement>(null);
  const messagesContainerRef = useRef<HTMLDivElement>(null);
  const messagesRef = useRef<Message[]>([]);
  
  // 流式更新节流
  const lastStreamUpdateTime = useRef<number>(0);
  const pendingStreamUpdate = useRef<{ content: string; messageId: string } | null>(null);
  const streamUpdateTimeout = useRef<ReturnType<typeof setTimeout> | null>(null); // 提前声明
  
  const { 
    deleteNode, 
    addMessage, 
    updateNodeData, 
    updateMessage,
    addEdge,
    edges,
    nodes,
    setExpandedNode,
    expandedNodeId,
    addStreamingNode,
    removeStreamingNode,
    canSendMessage,
    allowConcurrentStreaming,
    // 划线菜单相关
    showHighlightMenu,
    hideHighlightMenu,
    highlightMenuState,
    // 摘录相关
    addExcerpt,
    addHighlight,
    createNoteNode,
  } = useCanvasStore();
  
  // 使用 ref 保存最新 messages，避免依赖变化导致回调重建（在 messages 定义后）
  messagesRef.current = messages;
  
  // 使用 React 19 的 useTransition 优化流式更新性能
  // 将流式更新标记为过渡更新，让 React 优先处理高优先级的用户交互
  const [isPending, startTransition] = useTransition();
  
  // ===== 文本选中检测 =====
  
  // 处理文本选中完成
  const handleTextSelection = useCallback((selection: TextSelection) => {
    // 只处理 AI 消息的选中（用户消息也可以选中，但优先处理 AI 消息）
    showHighlightMenu({
      position: { x: selection.rect.left, y: selection.rect.bottom + 5 },
      selectedText: selection.text,
      selectedHtml: selection.html,
      sourceNodeId: id,
      sourceNodeTitle: title,
      sourceMessageId: selection.messageId,
      sourceRange: {
        startOffset: selection.startOffset,
        endOffset: selection.endOffset,
      },
      sourceFullContent: selection.fullContent,
    });
  }, [id, title, showHighlightMenu]);
  
  // 处理选区清除
  const handleSelectionClear = useCallback(() => {
    hideHighlightMenu();
  }, [hideHighlightMenu]);
  
  // 使用文本选中 Hook
  useTextSelection({
    containerRef: messagesContainerRef,
    onSelection: handleTextSelection,
    onSelectionClear: handleSelectionClear,
    minChars: 1,
  });
  
  // ===== 摘录处理 =====
  
  // 处理划线菜单操作
  const handleHighlightMenuAction = useCallback((type: 'excerpt' | 'note' | 'question' | 'branch') => {
    if (!highlightMenuState) return;
    
    // 分支操作：创建衍生节点深入讨论
    if (type === 'branch') {
      const { selectedText, sourceFullContent, sourceRange } = highlightMenuState;
      
      // 获取上下文
      let context = selectedText;
      if (sourceRange && sourceFullContent) {
        const contextLength = 150;
        const before = sourceFullContent.slice(
          Math.max(0, sourceRange.startOffset - contextLength),
          sourceRange.startOffset
        );
        const after = sourceFullContent.slice(
          sourceRange.endOffset,
          Math.min(sourceFullContent.length, sourceRange.endOffset + contextLength)
        );
        context = `${before ? '...' + before : ''}${selectedText}${after ? after + '...' : ''}`;
      }
      
      // 创建衍生节点
      const { createDerivedNode } = useCanvasStore.getState();
      const newNodeId = createDerivedNode(id, selectedText, context);
      
      hideHighlightMenu();
      
      // 将焦点移到新创建的节点（延迟执行，等待节点渲染）
      setTimeout(() => {
        const { setExpandedNode } = useCanvasStore.getState();
        setExpandedNode(newNodeId);
      }, 100);
      
      return;
    }
    
    // 提问操作：将选中内容以引用块形式虚挂在输入框上方
    if (type === 'question') {
      setActiveQuote({
        text: highlightMenuState.selectedText,
        messageId: highlightMenuState.sourceMessageId,
        sourceNodeTitle: highlightMenuState.sourceNodeTitle,
      });
      inputRef.current?.focus();
      hideHighlightMenu();
      return;
    }
    
    // 笔记操作：先弹出批注输入框
    if (type === 'note') {
      setPendingExcerptType('note');
      setShowNoteInputDialog(true);
      hideHighlightMenu();
      return;
    }
    
    // 摘录操作：检查是否有下游笔记框
    const downstreamEdges = edges.filter(e => e.source === id);
    const downstreamNoteNodes = downstreamEdges
      .map(e => nodes.find(n => n.id === e.target && n.type === 'noteNode'))
      .filter(Boolean);
    
    // 如果有且仅有一个下游笔记框，直接存入
    if (downstreamNoteNodes.length === 1) {
      const targetNode = downstreamNoteNodes[0]!;
      const { selectedText, selectedHtml, sourceMessageId, sourceRange, sourceFullContent } = highlightMenuState;
      
      // 获取上下文
      let sourceContext: { before: string; after: string } | undefined;
      if (sourceRange && sourceFullContent) {
        const contextLength = 100;
        const before = sourceFullContent.slice(
          Math.max(0, sourceRange.startOffset - contextLength),
          sourceRange.startOffset
        );
        const after = sourceFullContent.slice(
          sourceRange.endOffset,
          Math.min(sourceFullContent.length, sourceRange.endOffset + contextLength)
        );
        sourceContext = { before, after };
      }
      
      // 直接添加摘录到下游笔记框
      addExcerpt(
        {
          type: 'excerpt',
          content: selectedText,
          htmlContent: selectedHtml,
          sourceNodeId: id,
          sourceNodeTitle: title,
          sourceMessageId,
          sourceRange,
          sourceContext,
        },
        targetNode.id
      );
      
      hideHighlightMenu();
      return;
    }
    
    // 没有下游笔记框或有多个，显示目标节点选择器
    setPendingExcerptType('excerpt');
    setShowTargetPicker(true);
    hideHighlightMenu();
  }, [highlightMenuState, hideHighlightMenu, edges, id, nodes, addExcerpt, title]);
  
  // 处理批注输入确认
  const handleNoteInputConfirm = useCallback((note: string) => {
    setPendingNote(note);
    setShowNoteInputDialog(false);
    setShowTargetPicker(true);
  }, []);
  
  // 处理批注输入取消
  const handleNoteInputCancel = useCallback(() => {
    setShowNoteInputDialog(false);
  }, []);
  
  // 处理目标节点选择
  const handleTargetNodeSelect = useCallback((nodeId: string | 'new', nodeType: 'note') => {
    if (!highlightMenuState) return;
    
    const { selectedText, selectedHtml, sourceMessageId, sourceRange, sourceFullContent } = highlightMenuState;
    
    // 获取上下文
    let sourceContext: { before: string; after: string } | undefined;
    if (sourceRange && sourceFullContent) {
      const contextLength = 100;
      const before = sourceFullContent.slice(
        Math.max(0, sourceRange.startOffset - contextLength),
        sourceRange.startOffset
      );
      const after = sourceFullContent.slice(
        sourceRange.endOffset,
        Math.min(sourceFullContent.length, sourceRange.endOffset + contextLength)
      );
      sourceContext = { before, after };
    }
    
    // 创建摘录对象
    const excerptData = {
      type: pendingExcerptType as 'excerpt' | 'note',
      content: selectedText,
      htmlContent: selectedHtml,
      note: pendingNote || undefined, // 如果有批注则添加
      sourceNodeId: id,
      sourceNodeTitle: title,
      sourceMessageId,
      sourceRange,
      sourceContext,
    };
    
    if (nodeId === 'new') {
      // 创建新的笔记节点
      const newNodePosition = {
        x: (nodes.find(n => n.id === id)?.position?.x || 0) + 450,
        y: (nodes.find(n => n.id === id)?.position?.y || 0),
      };
      
      const newNodeId = createNoteNode(
        newNodePosition,
        pendingNote ? '带批注的笔记' : '新笔记'
      );
      
      // 添加摘录到新节点
      setTimeout(() => {
        addExcerpt(excerptData, newNodeId);
      }, 100);
    } else {
      // 添加摘录到已有节点
      addExcerpt(excerptData, nodeId);
    }
    
    // 关闭选择器并清空批注
    setShowTargetPicker(false);
    setPendingNote('');
  }, [highlightMenuState, pendingExcerptType, pendingNote, id, title, nodes, createNoteNode, addExcerpt]);
  
  // 获取该节点的上下文来源
  const contextSources = edges
    .filter((e) => e.target === id)
    .map((e) => e.source);
  
  // 获取上下文节点的信息
  const contextNodes = contextSources.map(sourceId => {
    const node = nodes.find((n) => n.id === sourceId);
    return node ? { id: node.id, title: node.data.title || '未命名', enabled: contextEnabled[sourceId] !== false } : null;
  }).filter(Boolean) as { id: string; title: string; enabled: boolean }[];
  
  // 自动滚动到底部 - 完全移除，因为会导致主线程阻塞
  // 如果需要滚动，可以在消息完成时单独处理
  // useEffect 已移除
  
  // 标题编辑模式自动聚焦
  useEffect(() => {
    if (isEditingTitle && titleInputRef.current) {
      titleInputRef.current.focus();
      titleInputRef.current.select();
    }
  }, [isEditingTitle]);
  
  // 标签添加自动聚焦
  useEffect(() => {
    if (isAddingTag && tagInputRef.current) {
      tagInputRef.current.focus();
    }
  }, [isAddingTag]);
  
  // 文件相关状态
  const [attachments, setAttachments] = useState<Attachment[]>([]);
  const [showFileUpload, setShowFileUpload] = useState(false);
  const fileInputRef = useRef<HTMLInputElement>(null);
  
  // 处理文件选择
  const handleFileSelect = useCallback(async (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = e.target.files;
    if (!files || files.length === 0) return;
    
    const newAttachments: Attachment[] = [];
    
    for (const file of Array.from(files)) {
      // 只处理图片文件（暂不支持其他文件类型）
      if (!file.type.startsWith('image/')) {
        alert('目前只支持上传图片文件');
        continue;
      }
      
      try {
        // 将文件转换为 base64
        const base64 = await new Promise<string>((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(reader.result as string);
          reader.onerror = reject;
          reader.readAsDataURL(file);
        });
        
        newAttachments.push({
          id: `att_${Date.now()}_${Math.random().toString(36).slice(2)}`,
          type: 'image',
          name: file.name,
          url: base64,
          size: file.size,
          mimeType: file.type,
        });
      } catch (error) {
        console.error('Failed to read file:', error);
        alert('文件读取失败');
      }
    }
    
    setAttachments(prev => [...prev, ...newAttachments]);
    setShowFileUpload(false);
    
    // 重置 file input
    if (fileInputRef.current) {
      fileInputRef.current.value = '';
    }
  }, []);
  
  // 移除附件
  const removeAttachment = useCallback((attachmentId: string) => {
    setAttachments(prev => prev.filter(att => att.id !== attachmentId));
  }, []);
  
  // 清空附件
  const clearAttachments = useCallback(() => {
    setAttachments([]);
  }, []);
  
  // 保存标题
  const saveTitle = useCallback(() => {
    const trimmed = editTitleValue.trim();
    if (trimmed && trimmed !== title) {
      updateNodeData(id, { title: trimmed });
    } else {
      setEditTitleValue(title);
    }
    setIsEditingTitle(false);
  }, [id, editTitleValue, title, updateNodeData]);
  
  // 添加标签
  const addTag = useCallback(() => {
    const trimmed = newTagValue.trim();
    if (trimmed && !tags.includes(trimmed)) {
      updateNodeData(id, { tags: [...tags, trimmed] });
    }
    setNewTagValue('');
    setIsAddingTag(false);
  }, [id, tags, newTagValue, updateNodeData]);
  
  // 删除标签
  const removeTag = useCallback((tagToRemove: string) => {
    updateNodeData(id, { tags: tags.filter(t => t !== tagToRemove) });
  }, [id, tags, updateNodeData]);
  
  // 切换上下文开关
  const toggleContext = useCallback((sourceId: string) => {
    updateNodeData(id, {
      contextEnabled: {
        ...contextEnabled,
        [sourceId]: contextEnabled[sourceId] === false ? true : false,
      },
    });
  }, [id, contextEnabled, updateNodeData]);
  
  // 更新节点状态
  const setStatus = useCallback((newStatus: NodeStatus) => {
    updateNodeData(id, { status: newStatus });
    setIsMenuOpen(false);
  }, [id, updateNodeData]);
  
  // 获取上下文消息（优化版：递归获取所有上游节点）
  const getContextMessages = useCallback((): Message[] => {
    // 获取所有上游节点（递归遍历）
    const contextNodes = getUpstreamNodes(
      id,
      nodes,
      edges,
      contextEnabled,
      3 // 最大深度
    );

    // 智能聚合上下文
    return aggregateContext(contextNodes, {
      maxNodes: 5,
      maxMessagesPerNode: 3,
      maxTotalLength: 2000,
      preferSummary: true,
    });
  }, [id, nodes, edges, contextEnabled]);
  
  // 发送消息
  const handleSend = useCallback(async () => {
    // 并发聊天已启用，不需要检查限制
    // 允许：有输入内容、有引用、或有附件时发送
    if ((!inputValue.trim() && !activeQuote && attachments.length === 0) || isStreaming) return;
    
    // 如果有引用，构建包含引用的消息内容
    let finalInputValue = inputValue.trim();
    if (activeQuote) {
      finalInputValue = `> ${activeQuote.text}\n\n${inputValue.trim()}`;
    }
    
    // 构建用户消息，支持多模态
    let messageContent: string | Array<{ type: string; text?: string; image_url?: { url: string } }>;
    
    if (attachments.length > 0) {
      // 多模态消息：包含文本和图片
      const contentParts: Array<{ type: string; text?: string; image_url?: { url: string } }> = [];
      
      // 添加文本内容（包含引用）
      if (finalInputValue) {
        contentParts.push({
          type: 'text',
          text: finalInputValue,
        });
      }
      
      // 添加图片附件
      attachments.forEach(att => {
        if (att.type === 'image') {
          contentParts.push({
            type: 'image_url',
            image_url: {
              url: att.url,
            },
          });
        }
      });
      
      messageContent = contentParts;
    } else {
      // 纯文本消息
      messageContent = finalInputValue;
    }
    
    const userMessage: Message = {
      id: `msg_${Date.now()}`,
      role: 'user',
      content: finalInputValue, // 前端保存纯文本用于显示（包含引用）
      timestamp: Date.now(),
      status: 'complete',
      attachments: attachments.length > 0 ? [...attachments] : undefined, // 保存附件信息
    };
    
    addMessage(id, userMessage);
    setInputValue('');
    setActiveQuote(null); // 清空引用
    clearAttachments(); // 清空附件
    
    if (status === 'idle') {
      setStatus('active');
    }
    
    const aiMessageId = `msg_${Date.now()}_ai`;
    addMessage(id, {
      id: aiMessageId,
      role: 'assistant',
      content: '',
      timestamp: Date.now(),
      status: 'streaming',
    });
    
    updateNodeData(id, { isStreaming: true });
    addStreamingNode(id); // 添加到全局 streaming 列表
    
    try {
      const contextMessages = getContextMessages();
      
      // 构建发送给 API 的消息列表（不再包含 system 消息，由 API 端统一处理）
      const allMessages: Array<{ role: string; content: string | Array<{ type: string; text?: string; image_url?: { url: string } }> }> = [
        ...messagesRef.current,
        {
          ...userMessage,
          content: messageContent, // 使用多模态内容
        },
      ];
      
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          messages: allMessages,
          contextMessages,
          nodeId: id,
          systemPrompt, // 单独传入系统提示词
        }),
      });
      
      if (!response.ok) {
        throw new Error('请求失败');
      }
      
      const reader = response.body?.getReader();
      const decoder = new TextDecoder();
      let fullContent = '';
      
      if (reader) {
        try {
          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            
            const chunk = decoder.decode(value, { stream: true });
            const lines = chunk.split('\n');
            
            for (const line of lines) {
              if (line.startsWith('data: ')) {
                try {
                  const json = JSON.parse(line.slice(6));
                  if (json.type === 'content' && json.content) {
                    fullContent += json.content;
                    
                    // 节流更新：每 250ms 最多更新一次，进一步减少主线程压力
                    const now = Date.now();
                    pendingStreamUpdate.current = { content: fullContent, messageId: aiMessageId };
                    
                    if (streamUpdateTimeout.current) {
                      clearTimeout(streamUpdateTimeout.current);
                    }
                    
                    streamUpdateTimeout.current = setTimeout(() => {
                      if (pendingStreamUpdate.current) {
                        // 使用 startTransition 将更新标记为过渡更新，让 React 优先处理高优先级交互
                        startTransition(() => {
                          updateMessage(id, pendingStreamUpdate.current!.messageId, pendingStreamUpdate.current!.content, 'streaming');
                          pendingStreamUpdate.current = null;
                        });
                      }
                    }, 300); // 增加到 300ms，进一步降低更新频率
                  }
                } catch {
                  // 忽略解析错误
                }
              }
            }
          }
        } catch (streamError) {
          console.error('Stream reading error:', streamError);
          // 如果有内容，标记为完成；否则标记为错误
          if (fullContent) {
            updateMessage(id, aiMessageId, fullContent, 'complete');
          } else {
            updateMessage(id, aiMessageId, '连接中断，请重试', 'error');
          }
        } finally {
          reader.releaseLock();
          // 清理节流定时器
          if (streamUpdateTimeout.current) {
            clearTimeout(streamUpdateTimeout.current);
            streamUpdateTimeout.current = null;
          }
          // 确保最终状态被更新
          if (pendingStreamUpdate.current) {
            updateMessage(id, aiMessageId, fullContent, 'complete');
            pendingStreamUpdate.current = null;
          } else if (fullContent) {
            updateMessage(id, aiMessageId, fullContent, 'complete');
          }
        }
      }
      
      updateNodeData(id, { isStreaming: false });
      removeStreamingNode(id); // 从全局 streaming 列表移除
      
      // 对话结束后自动生成摘要（每5轮对话更新一次）
      const updatedMessages: Message[] = [
        ...messagesRef.current, 
        userMessage, 
        { id: aiMessageId, role: 'assistant' as const, content: fullContent, timestamp: Date.now() }
      ];
      if (updatedMessages.length >= 4 && updatedMessages.length % 4 === 0) {
        generateSummary(updatedMessages);
      }
      
    } catch (error) {
      console.error('Chat error:', error);
      updateMessage(id, aiMessageId, '抱歉，发生了错误，请稍后重试。', 'error');
      updateNodeData(id, { isStreaming: false });
      removeStreamingNode(id); // 从全局 streaming 列表移除
    }
  }, [
    id,
    inputValue,
    isStreaming,
    // messages 已移至 messagesRef，避免依赖变化导致回调重建
    // messages,
    systemPrompt,
    status,
    addMessage,
    updateMessage,
    updateNodeData,
    setStatus,
    getContextMessages,
    addStreamingNode,
    removeStreamingNode,
    canSendMessage,
    allowConcurrentStreaming,
  ]);
  
  // 生成摘要
  const generateSummary = useCallback(async (msgs: Message[]) => {
    try {
      const response = await fetch('/api/summary', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          messages: msgs,
          nodeId: id,
        }),
      });
      
      if (!response.ok) return;
      
      const reader = response.body?.getReader();
      const decoder = new TextDecoder();
      let summary = '';
      
      if (reader) {
        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          
          const chunk = decoder.decode(value);
          const lines = chunk.split('\n');
          
          for (const line of lines) {
            if (line.startsWith('data: ')) {
              try {
                const json = JSON.parse(line.slice(6));
                if (json.type === 'done' && json.summary) {
                  summary = json.summary;
                }
              } catch {
                // 忽略解析错误
              }
            }
          }
        }
      }
      
      if (summary) {
        updateNodeData(id, { summary });
      }
    } catch (error) {
      console.error('Summary generation error:', error);
    }
  }, [id, updateNodeData]);
  
  // 键盘事件处理
  const handleKeyDown = (e: React.KeyboardEvent) => {
    if (e.key === 'Enter' && !e.shiftKey && !showReferencePicker) {
      e.preventDefault();
      handleSend();
    }
  };
  
  // 输入变化处理 - 检测 @ 符号
  const handleInputChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {
    const value = e.target.value;
    const cursorPos = e.target.selectionStart || 0;
    setInputValue(value);
    
    const lastAtIndex = value.lastIndexOf('@', cursorPos - 1);
    if (lastAtIndex !== -1) {
      const afterAt = value.slice(lastAtIndex + 1, cursorPos);
      if (!/[\s\n]/.test(afterAt)) {
        if (inputRef.current) {
          const rect = inputRef.current.getBoundingClientRect();
          setReferencePickerPosition({
            x: rect.left + 20,
            y: rect.bottom + 5,
          });
          setReferenceStartPos(lastAtIndex);
          setShowReferencePicker(true);
        }
      }
    } else {
      setShowReferencePicker(false);
    }
  };
  
  // 选择引用节点
  const handleSelectReference = useCallback((nodeId: string, refTitle: string) => {
    const beforeRef = inputValue.slice(0, referenceStartPos);
    const afterRef = inputValue.slice(inputRef.current?.selectionStart || 0);
    const newValue = `${beforeRef}[引用:${nodeId}:${refTitle}]${afterRef}`;
    setInputValue(newValue);
    setShowReferencePicker(false);
    
    if (!edges.some(e => e.source === nodeId && e.target === id)) {
      addEdge({
        id: `edge-${nodeId}-${id}`,
        source: nodeId,
        target: id,
        type: 'context',
      });
    }
  }, [inputValue, referenceStartPos, id, edges, addEdge]);
  
  // 折叠/展开切换
  const toggleCollapse = () => {
    updateNodeData(id, { collapsed: !collapsed });
  };
  
  // 手动生成摘要
  const handleManualSummary = useCallback(async () => {
    if (messages.length === 0) return;
    setIsMenuOpen(false);
    await generateSummary(messages);
  }, [messages, generateSummary]);
  
  return (
    <div
      ref={nodeRef}
      className={cn(
        'node-container',
        selected && 'selected',
        collapsed && 'min-h-0'
      )}
      style={{ width: NODE_WIDTH }}
      onDoubleClick={(e) => {
        // 如果双击的是标题区域、输入框或按钮，不触发展开
        const target = e.target as HTMLElement;
        if (
          target.closest('input') ||
          target.closest('textarea') ||
          target.closest('button') ||
          target.closest('[data-title-area]')
        ) {
          return;
        }
        setExpandedNode(id);
      }}
    >
      {/* ===== 四个方向的连接点 ===== */}

      {/* 顶部输入端口 - 用于父节点连接 */}
      <Handle
        type="target"
        position={Position.Top}
        id="top-target"
        style={{ top: -4 }}
      />

      {/* 底部输出端口 - 用于连接子节点 */}
      <Handle
        type="source"
        position={Position.Bottom}
        id="bottom-source"
        style={{ bottom: -4 }}
      />

      {/* 左侧输入端口 - 用于兄弟节点或上下文连接 */}
      <Handle
        type="target"
        position={Position.Left}
        id="left-target"
        style={{ left: -4 }}
      />

      {/* 右侧输出端口 - 用于兄弟节点或上下文连接 */}
      <Handle
        type="source"
        position={Position.Right}
        id="right-source"
        style={{ right: -4 }}
      />
      
      {/* 节点头部 */}
      <div className="flex items-center justify-between px-3 py-2 border-b" style={{ borderColor: 'var(--border-primary)' }}>
        <div className="flex items-center gap-2 flex-1 min-w-0">
          {/* 状态指示器 */}
          <div className={cn(
            'w-2 h-2 rounded-sm flex-shrink-0',
            status === 'idle' && 'bg-[#9B9A97]',
            status === 'active' && 'bg-[#2383E2] animate-pulse',
            status === 'completed' && 'bg-[#0F7B6C]',
          )} />

          {/* 图标 */}
          <div className="flex-shrink-0" style={{ color: 'var(--text-secondary)' }}>
            <MessageSquare className="w-4 h-4" />
          </div>

          {/* 标题 */}
          <div className="flex-1 min-w-0">
            {isEditingTitle ? (
              <input
                ref={titleInputRef}
                type="text"
                value={editTitleValue}
                onChange={(e) => setEditTitleValue(e.target.value)}
                onBlur={saveTitle}
                onKeyDown={(e) => {
                  if (e.key === 'Enter') {
                    e.preventDefault();
                    saveTitle();
                  }
                  if (e.key === 'Escape') {
                    setEditTitleValue(title);
                    setIsEditingTitle(false);
                  }
                }}
                className="w-full bg-transparent text-sm font-medium outline-none border-b"
                style={{
                  color: 'var(--text-primary)',
                  borderColor: 'var(--accent-primary)'
                }}
                placeholder="输入标题..."
              />
            ) : (
              <div
                className="flex items-center gap-1 cursor-pointer group"
                onDoubleClick={() => setIsEditingTitle(true)}
                data-title-area
              >
                <span className="text-sm font-medium truncate" style={{ color: 'var(--text-primary)' }}>
                  {title}
                </span>
                <Edit3 className="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" style={{ color: 'var(--text-secondary)' }} />
              </div>
            )}

            {/* 上下文来源指示 */}
            {contextNodes.length > 0 && (
              <button
                onClick={() => setShowContextPanel(!showContextPanel)}
                className="flex items-center gap-1 text-xs text-[#2383E2] hover:text-[#1A6BAC] transition-colors mt-0.5"
              >
                <Link2 className="w-3 h-3" />
                <span>{contextNodes.length} 个上下文</span>
              </button>
            )}
          </div>
        </div>
        
        {/* 右侧操作按钮 */}
        <div className="flex items-center gap-0.5">
          {/* 状态选择菜单 */}
          <div className="relative mr-1">
            <button
              onClick={() => setIsMenuOpen(!isMenuOpen)}
              className={cn(
                'w-6 h-6 rounded-full flex items-center justify-center',
                'transition-colors',
                status === 'idle' && 'bg-[#E9E9E7] text-[#787774] hover:bg-slate-600/50',
                status === 'active' && 'bg-bg-[#F7F6F3] text-[#2383E2]',
                status === 'completed' && 'bg-green-500/20 text-[#0F7B6C]',
              )}
            >
              {status === 'completed' ? <Check className="w-3.5 h-3.5" /> : <MoreVertical className="w-3.5 h-3.5" />}
            </button>
            
            {isMenuOpen && (
              <>
                <div 
                  className="fixed inset-0 z-40" 
                  onClick={() => setIsMenuOpen(false)}
                />
                <div className="absolute right-0 top-full mt-1 w-44 bg-[#1a1714] border border-bg-[#F7F6F3] rounded-lg shadow-md z-50 overflow-hidden">
                  {/* 状态选项 */}
                  <div className="px-2 py-1.5 text-xs text-[#9B9A97] border-b border-bg-[#F7F6F3]">设置状态</div>
                  <button
                    onClick={() => setStatus('idle')}
                    className="flex items-center gap-2 w-full px-3 py-2 text-sm text-[#787774] hover:bg-[#F7F6F3] transition-colors"
                  >
                    <div className="w-2.5 h-2.5 rounded-full bg-slate-500" />
                    未开始
                  </button>
                  <button
                    onClick={() => setStatus('active')}
                    className="flex items-center gap-2 w-full px-3 py-2 text-sm text-[#787774] hover:bg-[#F7F6F3] transition-colors"
                  >
                    <div className="w-2.5 h-2.5 rounded-full bg-amber-500" />
                    进行中
                  </button>
                  <button
                    onClick={() => setStatus('completed')}
                    className="flex items-center gap-2 w-full px-3 py-2 text-sm text-[#787774] hover:bg-[#F7F6F3] transition-colors"
                  >
                    <div className="w-2.5 h-2.5 rounded-full bg-green-500" />
                    已完成
                  </button>
                  
                  <div className="border-t border-bg-[#F7F6F3] mt-1" />
                  
                  {/* 其他选项 */}
                  <button
                    onClick={handleManualSummary}
                    className="flex items-center gap-2 w-full px-3 py-2 text-sm text-[#787774] hover:bg-[#F7F6F3] transition-colors"
                  >
                    <Sparkles className="w-3.5 h-3.5" />
                    生成摘要
                  </button>
                  <button
                    onClick={() => { setShowSettings(true); setIsMenuOpen(false); }}
                    className="flex items-center gap-2 w-full px-3 py-2 text-sm text-[#787774] hover:bg-[#F7F6F3] transition-colors"
                  >
                    <Settings className="w-3.5 h-3.5" />
                    系统提示词
                  </button>
                  <button
                    onClick={async () => {
                      setIsMenuOpen(false);
                      if (nodeRef.current) {
                        try {
                          const dataUrl = await toPng(nodeRef.current, {
                            quality: 1,
                            pixelRatio: 2,
                            backgroundColor: '#1a1a2e',
                            skipFonts: true,
                            fontEmbedCSS: '',
                          });
                          const link = document.createElement('a');
                          link.download = `${title || 'chat-node'}.png`;
                          link.href = dataUrl;
                          link.click();
                        } catch (err) {
                          console.error('导出图片失败:', err);
                        }
                      }
                    }}
                    className="flex items-center gap-2 w-full px-3 py-2 text-sm text-[#787774] hover:bg-[#F7F6F3] transition-colors"
                  >
                    <Download className="w-3.5 h-3.5" />
                    导出为图片
                  </button>
                  <button
                    onClick={() => { navigator.clipboard.writeText(title); setIsMenuOpen(false); }}
                    className="flex items-center gap-2 w-full px-3 py-2 text-sm text-[#787774] hover:bg-[#F7F6F3] transition-colors"
                  >
                    复制标题
                  </button>
                  <button
                    onClick={() => { deleteNode(id); setIsMenuOpen(false); }}
                    className="flex items-center gap-2 w-full px-3 py-2 text-sm text-[#E03E3E] hover:bg-[#FEF2F2] transition-colors"
                  >
                    <Trash2 className="w-3.5 h-3.5" />
                    删除节点
                  </button>
                </div>
              </>
            )}
          </div>
          
          {/* 展开为全屏按钮 */}
          <button
            onClick={() => setExpandedNode(id)}
            className="p-1.5 text-[#787774] hover:text-[#37352F] hover:bg-[#F7F6F3] rounded-lg transition-colors"
            title="展开为全屏聊天"
          >
            <Maximize2 className="w-4 h-4" />
          </button>
          
          {/* 折叠按钮 */}
          <button
            onClick={toggleCollapse}
            className="p-1.5 text-[#787774] hover:text-[#37352F] hover:bg-[#F7F6F3] rounded-lg transition-colors"
          >
            {collapsed ? (
              <ChevronDown className="w-4 h-4" />
            ) : (
              <ChevronUp className="w-4 h-4" />
            )}
          </button>
        </div>
      </div>
      
      {/* 上下文管理面板 */}
      {showContextPanel && contextNodes.length > 0 && !collapsed && (
        <div className="px-4 py-2 border-b border-bg-[#F7F6F3] bg-amber-500/5">
          <div className="text-xs text-[#787774] mb-2">上下文来源</div>
          <div className="space-y-1.5">
            {contextNodes.map((node) => (
              <div
                key={node.id}
                className="flex items-center justify-between py-1 px-2 rounded-lg bg-white/5"
              >
                <span className="text-xs text-[#787774] truncate">{node.title}</span>
                <button
                  onClick={() => toggleContext(node.id)}
                  className={cn(
                    'w-5 h-5 rounded flex items-center justify-center transition-colors',
                    node.enabled ? 'bg-bg-[#F7F6F3] text-[#2383E2]' : 'bg-stone-700/50 text-[#9B9A97]'
                  )}
                >
                  {node.enabled ? <Check className="w-3 h-3" /> : <X className="w-3 h-3" />}
                </button>
              </div>
            ))}
          </div>
        </div>
      )}
      
      {/* 系统提示词设置面板 */}
      {showSettings && !collapsed && (
        <SystemPromptInput
          nodeId={id}
          systemPrompt={systemPrompt}
          updateNodeData={updateNodeData}
          onClose={() => setShowSettings(false)}
        />
      )}
      
      {/* 标签区域 */}
      <div className="flex flex-wrap items-center gap-1.5 px-4 py-2 border-b border-bg-[#F7F6F3]">
        {tags.map((tag, index) => (
          <span
            key={index}
            className="group flex items-center gap-1 px-2 py-0.5 text-xs bg-bg-[#F7F6F3] text-[#1A6BAC] rounded-full"
          >
            #{tag}
            <button
              onClick={() => removeTag(tag)}
              className="opacity-0 group-hover:opacity-100 transition-opacity"
            >
              <X className="w-3 h-3" />
            </button>
          </span>
        ))}
        
        {isAddingTag ? (
          <input
            ref={tagInputRef}
            type="text"
            value={newTagValue}
            onChange={(e) => setNewTagValue(e.target.value)}
            onBlur={addTag}
            onKeyDown={(e) => {
              if (e.key === 'Enter') addTag();
              if (e.key === 'Escape') { setIsAddingTag(false); setNewTagValue(''); }
            }}
            placeholder="标签名..."
            className="w-20 px-2 py-0.5 text-xs bg-white/5 border border-bg-[#F7F6F3] rounded-full text-[#37352F] placeholder-[#C4C4C4] focus:outline-none"
          />
        ) : (
          <button
            onClick={() => setIsAddingTag(true)}
            className="flex items-center gap-0.5 px-2 py-0.5 text-xs text-[#9B9A97] hover:text-[#2383E2] transition-colors"
          >
            <Plus className="w-3 h-3" />
            标签
          </button>
        )}
      </div>
      
      {/* 摘要区域 - 可折叠 */}
      {summary && !collapsed && (
        <div className="border-b border-bg-[#F7F6F3] overflow-hidden transition-all duration-300">
          {/* 摘要标题栏 - 始终显示 */}
          <button
            onClick={() => setIsSummaryCollapsed(!isSummaryCollapsed)}
            className="w-full px-4 py-2.5 bg-amber-500/5 hover:bg-amber-500/8 flex items-center justify-between transition-colors group"
          >
            <div className="flex items-center gap-2">
              <Sparkles className="w-3.5 h-3.5 text-[#2383E2]" />
              <span className="text-xs text-[#2383E2] font-medium">知识摘要</span>
            </div>
            <div className="flex items-center gap-2">
              {!isSummaryCollapsed && (
                <span className="text-[10px] text-[#2383E2]/60 group-hover:text-[#2383E2]/80 transition-colors">
                  {summary.slice(0, 50)}{summary.length > 50 ? '...' : ''}
                </span>
              )}
              <ChevronDown 
                className={`w-3.5 h-3.5 text-[#2383E2]/60 transition-transform duration-300 ${
                  isSummaryCollapsed ? 'rotate-0' : 'rotate-180'
                }`}
              />
            </div>
          </button>
          
          {/* 摘要内容 - 可折叠 */}
          <div 
            className={`px-4 pb-3 overflow-hidden transition-all duration-300 ease-in-out ${
              isSummaryCollapsed 
                ? 'max-h-0 opacity-0' 
                : 'max-h-[300px] opacity-100'
            }`}
          >
            <div className="pt-2">
              <p className="text-xs text-[#787774] leading-relaxed whitespace-pre-wrap">
                {summary}
              </p>
            </div>
          </div>
        </div>
      )}
      
      {/* 聊天内容区域 - 非折叠状态 */}
      {!collapsed && (
        <>
          {/* 消息列表 - 增强滚动体验 */}
          <div 
            ref={messagesContainerRef}
            className="px-4 py-3 overflow-y-auto overflow-x-hidden scrollbar-chat"
            style={{ maxHeight: 450, minHeight: NODE_MIN_HEIGHT }}
          >
            {messages.length === 0 ? (
              <div className="flex flex-col items-center justify-center h-full text-center py-8">
                <div className="w-12 h-12 rounded-lg bg-bg-[#F7F6F3] flex items-center justify-center mb-3">
                  <Sparkles className="w-6 h-6 text-[#2383E2]/50" />
                </div>
                <p className="text-sm text-[#787774] mb-1">开始你的对话</p>
                <p className="text-xs text-[#9B9A97]">输入问题，AI 将为你解答</p>
              </div>
            ) : (
              <div className="space-y-3">
                {messages.map((message) => (
                  <MessageItem key={message.id} message={message} />
                ))}
                <div ref={messagesEndRef} />
              </div>
            )}
          </div>
          
          {/* 计划识别组件 */}
          <div className="px-4">
            <PlanDetector
              nodeId={id}
              messages={messages}
              onCreateNodes={(plan) => {
                const { createNodesFromPlan } = useCanvasStore.getState();
                createNodesFromPlan(id, plan);
              }}
            />
          </div>
          
          {/* 输入区域 */}
          <div className="px-4 pb-4">
            {/* 引用块 - 显示在输入框上方 */}
            {activeQuote && (
              <QuoteBlock
                quote={activeQuote}
                onRemove={() => setActiveQuote(null)}
                isFocused={inputFocused}
              />
            )}
            
            {/* 附件预览区域 */}
            {attachments.length > 0 && (
              <div className="flex flex-wrap gap-2 mb-3">
                {attachments.map((attachment) => (
                  <div
                    key={attachment.id}
                    className="relative group"
                  >
                    {attachment.type === 'image' ? (
                      <div className="relative w-16 h-16 rounded-lg overflow-hidden border border-bg-[#F7F6F3] bg-white/5">
                        <img
                          src={attachment.url}
                          alt={attachment.name}
                          className="w-full h-full object-cover"
                        />
                        <button
                          onClick={() => removeAttachment(attachment.id)}
                          className="absolute top-1 right-1 p-0.5 bg-red-500/80 rounded-full opacity-0 group-hover:opacity-100 transition-opacity"
                        >
                          <X className="w-3 h-3 text-[#37352F]" />
                        </button>
                      </div>
                    ) : (
                      <div className="w-16 h-16 rounded-lg border border-bg-[#F7F6F3] bg-white/5 flex items-center justify-center">
                        <Paperclip className="w-6 h-6 text-[#787774]" />
                      </div>
                    )}
                  </div>
                ))}
                {attachments.length > 0 && (
                  <button
                    onClick={clearAttachments}
                    className="px-2 py-1 text-xs text-[#9B9A97] hover:text-[#E03E3E] transition-colors"
                  >
                    清空
                  </button>
                )}
              </div>
            )}
            
            <div className="relative">
              {/* 文件上传按钮 */}
              <input
                ref={fileInputRef}
                type="file"
                accept="image/*"
                multiple
                onChange={handleFileSelect}
                className="hidden"
              />
              <button
                onClick={() => fileInputRef.current?.click()}
                disabled={isStreaming}
                className="absolute left-3 bottom-3 p-2 text-[#787774] hover:text-[#37352F] hover:bg-[#F7F6F3] rounded-lg transition-colors disabled:opacity-50"
                title="上传图片"
              >
                <ImageIcon className="w-4 h-4" />
              </button>
              
              <textarea
                ref={inputRef}
                value={inputValue}
                onChange={handleInputChange}
                onKeyDown={handleKeyDown}
                onFocus={() => setInputFocused(true)}
                onBlur={() => setInputFocused(false)}
                placeholder="输入消息... (Enter 发送，@ 引用节点，可上传图片)"
                disabled={isStreaming || (!allowConcurrentStreaming && !canSendMessage() && id !== expandedNodeId)}
                rows={2}
                className={cn(
                  'w-full pl-12 pr-12 py-3 text-sm text-[#37352F] placeholder-[#C4C4C4]',
                  'bg-white/5 border border-bg-[#F7F6F3] rounded-lg resize-none',
                  'focus:outline-none focus:border-amber-500/50 focus:ring-2 focus:ring-bg-[#F7F6F3]',
                  'disabled:opacity-50 disabled:cursor-not-allowed',
                  'transition-all duration-200'
                )}
              />
              <button
                onClick={handleSend}
                disabled={(!inputValue.trim() && !activeQuote && attachments.length === 0) || isStreaming || (!allowConcurrentStreaming && !canSendMessage() && id !== expandedNodeId)}
                className={cn(
                  'absolute right-3 bottom-3 p-2 rounded-lg',
                  'transition-all duration-200',
                  (inputValue.trim() || activeQuote || attachments.length > 0) && !isStreaming
                    ? 'bg-amber-500 text-[#37352F] hover:bg-amber-600 shadow-lg shadow-amber-500/25'
                    : 'bg-[#E9E9E7] text-[#9B9A97] cursor-not-allowed'
                )}
              >
                <svg
                  className="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    strokeLinecap="round"
                    strokeLinejoin="round"
                    strokeWidth={2}
                    d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"
                  />
                </svg>
              </button>
            </div>
            
            {/* AI 助手按钮 */}
            {messages.length > 0 && (
              <div className="flex items-center justify-end mt-2">
                <AIAssistant 
                  nodeId={id} 
                  messages={messages.map((m) => ({ role: m.role, content: m.content }))} 
                />
              </div>
            )}
          </div>
        </>
      )}
      
      {/* 折叠状态显示 */}
      {collapsed && (
        <div className="px-4 py-3">
          <div className="flex items-center justify-between text-xs text-[#9B9A97]">
            <span>{messages.length} 条消息</span>
            {status === 'completed' && (
              <span className="text-[#0F7B6C]">✓ 已完成</span>
            )}
          </div>
        </div>
      )}
      
      {/* 选中状态发光效果 */}
      {selected && (
        <div className="absolute inset-0 rounded-lg pointer-events-none">
          <div className="absolute inset-0 rounded-lg bg-amber-500/5 animate-pulse-soft" />
        </div>
      )}
      
      {/* 节点引用选择器 */}
      {showReferencePicker && (
        <NodeReferencePicker
          currentNodeId={id}
          position={referencePickerPosition}
          onSelect={handleSelectReference}
          onClose={() => setShowReferencePicker(false)}
        />
      )}
      
      {/* 划线菜单 */}
      <HighlightMenu
        onClose={() => hideHighlightMenu()}
        onAction={handleHighlightMenuAction}
      />
      
      {/* 目标节点选择器 */}
      {showTargetPicker && highlightMenuState && (
        <TargetNodePicker
          position={{
            x: highlightMenuState.position.x,
            y: highlightMenuState.position.y,
          }}
          actionType={pendingExcerptType}
          onSelect={handleTargetNodeSelect}
          onClose={() => setShowTargetPicker(false)}
        />
      )}
      
      {/* 批注输入弹窗 */}
      {showNoteInputDialog && highlightMenuState && (
        <NoteInputDialog
          selectedText={highlightMenuState.selectedText}
          position={{
            x: highlightMenuState.position.x,
            y: highlightMenuState.position.y,
          }}
          onConfirm={handleNoteInputConfirm}
          onCancel={handleNoteInputCancel}
        />
      )}
    </div>
  );
}

// 使用 memo 优化，避免不必要的重新渲染
export const ChatNode = memo(ChatNodeComponent, (prevProps, nextProps) => {
  // 自定义比较：只有当节点的关键数据变化时才重新渲染
  const prevData = prevProps.data;
  const nextData = nextProps.data;

  // 如果 selected 状态变化，需要重新渲染
  if (prevProps.selected !== nextProps.selected) return false;

  // 如果关键数据变化，需要重新渲染
  if (
    prevData.title !== nextData.title ||
    prevData.collapsed !== nextData.collapsed ||
    prevData.isStreaming !== nextData.isStreaming ||
    prevData.status !== nextData.status ||
    prevData.summary !== nextData.summary ||
    prevData.systemPrompt !== nextData.systemPrompt ||
    prevData.messages?.length !== nextData.messages?.length ||
    prevData.tags?.length !== nextData.tags?.length
  ) {
    return false; // 需要重新渲染
  }

  // 如果 messages 数组长度相同，检查最后一条消息的内容（流式输出时只需要检查最后一条）
  if (prevData.messages && nextData.messages && prevData.messages.length === nextData.messages.length) {
    const lastPrev = prevData.messages[prevData.messages.length - 1];
    const lastNext = nextData.messages[nextData.messages.length - 1];
    if (lastPrev && lastNext && lastPrev.id === lastNext.id) {
      // 如果最后一条消息的 id 相同，检查关键属性
      if (
        lastPrev.content !== lastNext.content ||
        lastPrev.status !== lastNext.status
      ) {
        return false; // 消息内容变化，需要重新渲染
      }
    }
  }

  // 其他情况不需要重新渲染
  return true; // 不需要重新渲染
});
