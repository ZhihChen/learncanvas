# ===========================================
# LearnCanvas .gitignore
# ===========================================

# Build outputs
.next
.rsbuild/
out/
dist/
build/

# Dependencies
node_modules/
.pnp
.pnp.js
.pnpm-store/

# Environment variables (NEVER commit these!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# TypeScript
*.tsbuildinfo
tsconfig.tsbuildinfo

# Cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.turbo/

# Temporary files
*.tmp
*.temp
.tmp/
.temp/

# Optional files
*.tgz
*.gz
*.zip
*.tar

# Coze CLI
.coze
.coze-logs/
.cozeproj

# Vercel
.vercel/

# Misc
*.pid
*.seed
*.pid.lock
