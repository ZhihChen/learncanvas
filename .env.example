# ===========================================
# LearnCanvas 环境变量配置
# ===========================================
# 复制此文件为 .env.local 并填入实际值
# cp .env.example .env.local

# ===========================================
# 火山引擎 ARK API 配置（必需）
# ===========================================
# ARK API 文档：https://www.volcengine.com/docs/82379/1263482

# API 基础地址（火山引擎 ARK API 端点）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# API Key（从火山引擎控制台获取）
ARK_API_KEY=your_ark_api_key_here

# 模型配置
# 对话模型（推荐：doubao-seed-2-0-pro-260215）
ARK_MODEL=doubao-seed-2-0-pro-260215

# 视觉模型（支持图片理解）
ARK_VISION_MODEL=doubao-seed-1-6-vision-250815

# ===========================================
# 对象存储配置（S3 兼容）
# ===========================================
# 支持：火山引擎 TOS、AWS S3、MinIO 等 S3 兼容存储

# S3 端点地址
# 火山引擎 TOS 示例：https://tos-cn-beijing.volcengineobjects.com
# AWS S3 示例：https://s3.amazonaws.com
S3_ENDPOINT=https://your-s3-endpoint.com

# S3 区域
S3_REGION=cn-beijing

# S3 Access Key（从云服务商获取）
S3_ACCESS_KEY_ID=your_access_key_id

# S3 Secret Access Key（从云服务商获取）
S3_SECRET_ACCESS_KEY=your_secret_access_key

# S3 存储桶名称
S3_BUCKET_NAME=your_bucket_name

# ===========================================
# 应用配置（可选）
# ===========================================

# Next.js 应用端口（默认 5000）
PORT=5000

# 应用环境
NODE_ENV=development

# API 密钥（用于保护某些敏感接口）
# API_SECRET_KEY=your_api_secret_key

# ===========================================
# 配置示例
# ===========================================

# 示例 1：仅使用 AI 对话功能（不需要文件上传）
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# ARK_API_KEY=your_key_here
# ARK_MODEL=doubao-seed-2-0-pro-260215

# 示例 2：完整配置（AI + 文件上传）
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# ARK_API_KEY=your_key_here
# S3_ENDPOINT=https://tos-cn-beijing.volcengineobjects.com
# S3_REGION=cn-beijing
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET_NAME=your-bucket
